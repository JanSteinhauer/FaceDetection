# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf
*.pyx text eol=lf
*.pxd text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary
*.pyc binary
*.pyo binary
*.so binary
*.dylib binary
*.h5 binary
*.keras binary
*.caffemodel binary
*.pb binary

# Exclude from exports
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
test_*.py export-ignore

# Mark as documentation for GitHub linguist
*.md linguist-documentation
CHANGELOG.md linguist-documentation
LICENSE linguist-documentation
